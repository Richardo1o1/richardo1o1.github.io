ot;&gt;32&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;33&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;34&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;35&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;36&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;37&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;38&lt;/span&gt;&lt;br&gt;&lt;/pre&gt;&lt;/td&gt;&lt;td class=&quot;code&quot;&gt;&lt;pre&gt;&lt;span class=&quot;line&quot;&gt;enum GameType &amp;#123;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  mcq&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  open_ended&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&amp;#125;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;model Game &amp;#123;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  id          String     @id @default(cuid())&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  userId      String&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  questions   Question[]&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  timeStarted DateTime&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  topic       String&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  timeEnded   DateTime?&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  gameType    GameType&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  @@index([userId])&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&amp;#125;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;model topic_count &amp;#123;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  id    String @id @default(cuid())&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  topic String @unique&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  count Int&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&amp;#125;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;model Question &amp;#123;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  id                String   @id @default(cuid())&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  question          String&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  answer            String&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  gameId            String&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  options           Json? // for mcq questions&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  percentageCorrect Float? // for open_ended questions&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  isCorrect         Boolean? // for mcq questions&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  questionType      GameType&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  userAnswer        String?&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  game Game @relation(fields: [gameId], references: [id])&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;  @@index([gameId])&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;line&quot;&gt;&amp;#125;&lt;/span&gt;&lt;br&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/figure&gt;
